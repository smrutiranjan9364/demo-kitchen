# Copy to .env.local and set your own values.
# Leave the URL blank until the real domain is available. Use an HTTPS origin
# (no path or trailing slash). Set SEO_INDEXABLE=true only on the production host.
# Development and recognized Vercel/Netlify previews remain noindex automatically.
SITE_URL=
SEO_INDEXABLE=false

# Required in production. Without ADMIN_USERNAME / ADMIN_PASSWORD the bootstrap
# super-admin account is disabled; without ADMIN_SESSION_SECRET the admin area
# refuses to start a session at all. The values below are development defaults.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=generate-a-long-random-string

# Transactional email (order + contact notifications) over SMTP via nodemailer.
# Leave SMTP_HOST unset locally and mails are logged to the console instead.
# Gmail: host smtp.gmail.com, port 465, user = your address, pass = an App
# Password (Google Account → Security → 2-Step Verification → App passwords).
# Gmail sends as the authenticated account, so MAIL_FROM must use that address.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=odiakitchen@gmail.com
SMTP_PASS=
MAIL_FROM=Odia Kitchen <odiakitchen@gmail.com>

# Postgres (Neon). Use the POOLED endpoint (…-pooler.neon.tech) for serverless.
DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
